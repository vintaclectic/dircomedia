# Database
DATABASE_URL=postgresql+asyncpg://dirco:dirco@localhost:5432/dircomedia

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI / Content Generation
ANTHROPIC_API_KEY=sk-ant-...
REPLICATE_API_TOKEN=r8_...
OPENAI_API_KEY=sk-...  # fallback image gen

# Video Pipeline
CREATOMATE_API_KEY=...
RUNWAY_API_KEY=...
KLING_API_KEY=...
HEYGEN_API_KEY=...

# X / Twitter
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...
TWITTER_BEARER_TOKEN=...

# TikTok
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_ACCESS_TOKEN=...

# Instagram (via Facebook Graph API)
INSTAGRAM_APP_ID=...
INSTAGRAM_APP_SECRET=...
INSTAGRAM_ACCESS_TOKEN=...

# Reddit
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USERNAME=...
REDDIT_PASSWORD=...

# Cloudflare R2 Storage
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=dircomedia
R2_PUBLIC_URL=https://assets.dircomedia.app

# App
BRAND_CONFIGS_DIR=/app/brand_configs
MEDIA_UPLOAD_DIR=/tmp/dircomedia/uploads

# Security (Phase 0)
OWNER_API_TOKEN=generate-with: openssl rand -hex 32

# Broadcast Spine (Phase 1)
BROADCAST_KILL_SWITCH=false
BROADCAST_DAILY_CAP=10
BROADCAST_DEDUPE_HOURS=24
BRAIN_WEBHOOK_URL=
BRAIN_WEBHOOK_TOKEN=

# Model tiering (frugal-max ruling: Opus never for post text)
CONTENT_TEXT_MODEL=claude-sonnet-4-5
VIDEO_SCRIPT_MODEL=claude-sonnet-4-5

# Phase 2 platforms (council decree 2026-07-04)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
